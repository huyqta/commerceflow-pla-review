# ==============================================================================
# CommerceFlow - Git Ignore Configuration
# ==============================================================================

# --- Node.js & Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
id_rsa
id_rsa.pub

# --- Terraform & Infrastructure ---
# Local .terraform directory containing cached provider binaries (> 100MB)
**/.terraform/
.terraform/
.terraform.lock.hcl

# Terraform state files (CRITICAL: contain plaintext database passwords and secrets)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variable definition files with potential secrets
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform crash and override files
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# --- Build Outputs, Caches & Temporary Files ---
dist/
build/
out/
.next/
*.tsbuildinfo
.eslintcache
.parcel-cache
.cache/
tmp/
temp/

# --- Testing & Coverage ---
coverage/
.nyc_output/
*.lcov

# --- OS Specific Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- IDE & Editor Settings ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# --- Cloud SDK & Local Credentials ---
.gcloud/
client_secret*.json
service-account*.json
credentials.json
