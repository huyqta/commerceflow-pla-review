// apps/order-service/prisma/schema.prisma
// Đặc tả cấu trúc cơ sở dữ liệu PostgreSQL cho Ordering Bounded Context
// Hỗ trợ ACID Transactions, Invariants, Transactional Outbox và Idempotency (R-01, R-02, R-03, R-04)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model Order {
  id             String      @id
  orderNumber    String      @unique @map("order_number")
  customerId     String      @map("customer_id")
  status         OrderStatus @default(PENDING)
  totalAmount    Decimal     @map("total_amount") @db.Decimal(12, 2)
  currency       String      @default("VND") @db.VarChar(10)
  version        Int         @default(1)
  idempotencyKey String?     @unique @map("idempotency_key")
  correlationId  String?     @map("correlation_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  items          OrderItem[]

  @@index([customerId], name: "idx_orders_customer_id")
  @@index([status], name: "idx_orders_status")
  @@index([createdAt], name: "idx_orders_created_at")
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  productId   String   @map("product_id")
  productName String?  @map("product_name")
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId], name: "uq_order_items_order_product")
  @@index([orderId], name: "idx_order_items_order_id")
  @@index([productId], name: "idx_order_items_product_id")
  @@map("order_items")
}

model OutboxEvent {
  id            String       @id @default(uuid())
  aggregateType String       @default("Order") @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  eventType     String       @map("event_type")
  payload       Json
  correlationId String?      @map("correlation_id")
  status        OutboxStatus @default(PENDING)
  publishedAt   DateTime?    @map("published_at")
  retryCount    Int          @default(0) @map("retry_count")
  lastError     String?      @map("last_error")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([status, createdAt], name: "idx_outbox_events_status_created")
  @@map("outbox_events")
}

