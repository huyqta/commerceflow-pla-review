{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PLA Roadmap",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "domain",
    "content_language",
    "milestones",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "gate"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "gate": {
            "type": "string",
            "minLength": 8
          }
        },
        "additionalProperties": true
      }
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "milestone",
          "depends_on",
          "learning_objectives",
          "steps",
          "deliverables",
          "acceptance_criteria",
          "verification",
          "estimated_hours",
          "labels",
          "knowledge",
          "troubleshooting",
          "reflection"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2
          },
          "title": {
            "type": "string",
            "minLength": 5
          },
          "milestone": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "learning_objectives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 8
            }
          },
          "steps": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "deliverables": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 8
            }
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 8
            }
          },
          "estimated_hours": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "knowledge": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "troubleshooting": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "reflection": {
            "type": "string",
            "minLength": 8
          },
          "kind": {
            "type": "string",
            "enum": [
              "foundations",
              "environment",
              "lab",
              "implementation",
              "review",
              "release"
            ]
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "draft/unverified",
              "reviewed",
              "verified",
              "blocked",
              "failed"
            ]
          },
          "verification_evidence": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "content_language": {
      "type": "string",
      "enum": [
        "vi",
        "en"
      ],
      "description": "User-selected language of human-facing course and GitHub content"
    }
  },
  "additionalProperties": true
}
